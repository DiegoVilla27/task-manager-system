#!/usr/bin/env sh

echo "🐳 [pre-push] Validando estado de Docker..."
if ! docker info >/dev/null 2>&1; then
  echo "❌ [pre-push] Error: Docker daemon no está en ejecución. Debes iniciar Docker para poder hacer push."
  exit 1
fi

echo "🔨 [pre-push] Reconstruyendo y actualizando contenedores de Docker (modo estricto)..."
docker compose up --build -d || {
  echo "❌ [pre-push] Error: Falló la construcción o recreación de contenedores de Docker. Push cancelado."
  exit 1
}

echo "✅ [pre-push] Contenedores de Docker reconstruidos y actualizados exitosamente."
