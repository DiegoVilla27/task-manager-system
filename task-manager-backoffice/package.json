{
  "name": "task-manager-backoffice",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,css,json}\"",
    "format:write": "prettier --write \"src/**/*.{ts,html,scss,css,json}\"",
    "test": "ng test",
    "test:unit": "ng test --watch=false --browsers=ChromeHeadlessCI --code-coverage",
    "test:integration": "ng test --watch=false --browsers=ChromeHeadlessCI",
    "test:coverage": "ng test --watch=false --browsers=ChromeHeadlessCI --code-coverage",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadlessCI --code-coverage"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^19.2.19",
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/platform-browser": "^19.2.0",
    "@angular/platform-browser-dynamic": "^19.2.0",
    "@angular/router": "^19.2.0",
    "@lucide/angular": "^1.31.0",
    "@tanstack/angular-query-experimental": "^5.101.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.27",
    "@angular-eslint/eslint-plugin": "^22.1.0",
    "@angular-eslint/eslint-plugin-template": "^22.1.0",
    "@angular-eslint/template-parser": "^22.1.0",
    "@angular/cli": "^19.2.27",
    "@angular/compiler-cli": "^19.2.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jasmine": "~5.1.0",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.67.0"
  }
}
